# .gitignore برای پروژه Trainova

# فایل‌های سیستمی
.DS_Store
Thumbs.db
desktop.ini

# لاگ‌ها
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# پوشه‌های موقت
tmp/
temp/
.cache/

# وابستگی‌ها
node_modules/
vendor/

# فایل‌های محیطی
.env
.env.local
.env.*.local

# تنظیمات IDE
.vscode/
.idea/
*.swp
*.swo
*~

# فایل‌های بیلد Next.js (اگر نیاز نیست)
# _next/static/webpack/
# .next/

# فایل‌های تست
coverage/
.nyc_output/

# فایل‌های موقت آپلود
uploads/
downloads/

# دیتابیس‌های محلی
*.sqlite
*.db

# فایل‌های رمزنگاری شده
*.key
*.pem
*.crt
